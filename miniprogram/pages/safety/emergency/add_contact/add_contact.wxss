.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.form-container {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 15rpx;
  font-weight: bold;
}

.form-input {
  border: 1rpx solid #e8e8e8;
  border-radius: 8rpx;
  padding: 20rpx;
  background-color: #fff;
}

.form-input input {
  font-size: 28rpx;
  color: #333;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

.btn-group {
  display: flex;
  justify-content: space-between;
  margin-top: 60rpx;
}

.btn {
  width: 45%;
  padding: 20rpx 0;
  border-radius: 8rpx;
  font-size: 30rpx;
  text-align: center;
}

.cancel {
  background-color: #f5f5f5;
  color: #666;
}

.save {
  background-color: #4CAF50;
  color: white;
}

.save:active {
  background-color: #3d8b40;
}