/* pages/safety/emergency/location/location.wxss */
.container {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #f8f8f8;
  min-height: 100vh;
}

/* 加载动画 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 100rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 6rpx solid #f3f3f3;
  border-top: 6rpx solid #E53935;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 紧急提示 */
.emergency-alert {
  width: 100%;
  background-color: #E53935;
  color: white;
  padding: 20rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.1);
}

.alert-icon {
  font-size: 44rpx;
  margin-right: 15rpx;
}

.alert-text {
  font-size: 36rpx;
  font-weight: bold;
  flex: 1;
}

.alert-time {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 位置信息 */
.location-info {
  width: 100%;
  background-color: white;
  padding: 20rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 5rpx rgba(0,0,0,0.05);
}

.location-address {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
  color: #333;
}

.location-coords {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 地图 */
.location-map {
  width: 100%;
  height: 500rpx;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 5rpx rgba(0,0,0,0.05);
}

/* 操作按钮 */
.action-buttons {
  width: 100%;
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.action-btn {
  flex: 1;
  margin: 0 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  border-radius: 10rpx;
  background-color: white;
  box-shadow: 0 2rpx 5rpx rgba(0,0,0,0.1);
  border: none;
  font-size: 28rpx;
}

.action-btn::after {
  border: none;
}

.call-btn {
  background-color: #E53935;
  color: white;
}

.map-btn {
  background-color: #4CAF50;
  color: white;
}

.btn-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

/* 提示信息 */
.tips {
  width: 100%;
  background-color: white;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 5rpx rgba(0,0,0,0.05);
}

.tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-icon {
  margin-right: 15rpx;
  font-size: 32rpx;
}