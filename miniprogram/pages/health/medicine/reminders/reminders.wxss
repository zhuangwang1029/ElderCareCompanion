.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.reminder-list {
  margin-bottom: 60rpx;
}

.reminder-item {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.reminder-medicine-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.reminder-details {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.reminder-time, .reminder-dosage {
  display: flex;
  align-items: center;
  color: #666;
  font-size: 32rpx;
}

.reminder-time image, .reminder-dosage image {
  width: 32rpx;
  height: 32rpx;
  margin-right: 10rpx;
}

.reminder-instruction {
  font-size: 28rpx;
  color: #888;
  margin-bottom: 20rpx;
}

.reminder-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  font-size: 28rpx;
  color: #666;
}

.action-btn {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.divider {
  margin: 0 10rpx;
  color: #ddd;
}

.action-btn.active {
  color: #4CAF50;
}

.action-btn.inactive {
  color: #999;
}

.no-reminders {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.no-reminders image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  opacity: 0.5;
}

.no-reminders-text {
  font-size: 36rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.no-reminders-tip {
  font-size: 28rpx;
  color: #bbb;
}