/* pages/health/medicine/medicine.wxss */
.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 32rpx;
  color: #666666;
}

.no-medicine {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
}

.empty-text {
  font-size: 34rpx;
  color: #999999;
  margin-bottom: 50rpx;
}

.add-btn {
  background-color: #4CAF50;
  color: white;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.medicine-list {
  margin-bottom: 100rpx;
}

.medicine-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #ffffff;
  padding: 40rpx;
  margin-bottom: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.medicine-name {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.medicine-time {
  font-size: 30rpx;
  color: #4CAF50;
  margin-bottom: 10rpx;
}

.medicine-desc {
  font-size: 28rpx;
  color: #666666;
}

.medicine-actions {
  display: flex;
  flex-direction: column;
}

.take-btn, .edit-btn, .reminder-btn {
  font-size: 28rpx;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  line-height: 1.5;
  margin: 5rpx 0;
}

.take-btn {
  background-color: #4CAF50;
  color: white;
}

.edit-btn {
  background-color: #2196F3;
  color: white;
}

.reminder-btn {
  background-color: #FF9800;
  color: white;
}

.take-btn.took {
  background-color: #ddd;
  color: #666;
}

.delete-btn {
  background: #E53935;
  color: white;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  min-height: 50rpx;
  margin-left: 10rpx;
  line-height: 50rpx;
  border-radius: 25rpx;
}

.float-btn {
  position: fixed;
  bottom: 50rpx;
  right: 50rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #4CAF50;
  color: white;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.4);
}