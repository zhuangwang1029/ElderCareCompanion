.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.subtitle {
  font-size: 32rpx;
  color: #666;
  margin-top: 10rpx;
}

.reminder-section {
  background-color: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.section-subtitle {
  font-size: 30rpx;
  color: #666;
  margin: 20rpx 0 10rpx;
}

.preset-times {
  display: flex;
  flex-direction: column;
}

.time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.time-item:last-child {
  border-bottom: none;
}

.time-item.active .time-name {
  color: #4CAF50;
  font-weight: bold;
}

.time-name {
  font-size: 32rpx;
  color: #333;
}

.time-value {
  font-size: 32rpx;
  color: #4CAF50;
  background-color: #f9f9f9;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
}

.custom-times {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #eee;
}

.custom-time-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 0;
}

.delete-btn {
  color: #E53935;
  font-size: 28rpx;
}

.reminder-types {
  display: flex;
  justify-content: space-between;
}

.reminder-type {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 30%;
  padding: 20rpx 0;
  border-radius: 12rpx;
  background-color: #f9f9f9;
}

.reminder-type.active {
  background-color: #E8F5E9;
  border: 1rpx solid #4CAF50;
}

.type-icon {
  width: 60rpx;
  height: 60rpx;
  margin-bottom: 10rpx;
}

.type-name {
  font-size: 28rpx;
  color: #333;
}

.advance-setting {
  padding: 10rpx 0;
}

.slider-container {
  padding: 20rpx 0;
}

.advance-desc {
  text-align: center;
  font-size: 28rpx;
  color: #666;
  margin-top: 10rpx;
}

.switch-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.switch-label {
  font-size: 32rpx;
  color: #333;
}

.repeat-setting {
  display: flex;
  align-items: center;
  padding: 15rpx 0;
  margin-top: 10rpx;
  background-color: #f9f9f9;
  border-radius: 12rpx;
  padding: 20rpx;
}

.repeat-label {
  font-size: 28rpx;
  color: #666;
}

.picker {
  background-color: #E8F5E9;
  color: #4CAF50;
  font-size: 32rpx;
  padding: 8rpx 20rpx;
  margin: 0 10rpx;
  border-radius: 8rpx;
  min-width: 80rpx;
  text-align: center;
}

.buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 60rpx;
  padding: 0 30rpx;
  margin-bottom: 60rpx;
}

.cancel-btn, .save-btn {
  width: 45%;
  border-radius: 50rpx;
  font-size: 34rpx;
  padding: 20rpx 0;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.save-btn {
  background-color: #4CAF50;
  color: white;
}