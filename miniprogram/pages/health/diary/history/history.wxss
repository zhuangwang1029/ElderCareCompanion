.container {
  padding: 30rpx;
  background-color: #f8f8f8;
  min-height: 100vh;
}

.header {
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333333;
}

.calendar-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.month-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.month-title {
  font-size: 32rpx;
  font-weight: bold;
}

.arrow {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666;
  background-color: #f5f5f5;
  border-radius: 50%;
}

.weekdays {
  display: flex;
  margin-bottom: 10rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #999;
  padding: 10rpx 0;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
}

.day, .day-placeholder {
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day {
  border-radius: 10rpx;
  font-size: 28rpx;
}

.day-number {
  margin-bottom: 6rpx;
}

.today {
  background-color: #E8F5E9;
  color: #4CAF50;
  font-weight: bold;
}

.has-record {
  position: relative;
}

.selected {
  background-color: #4CAF50;
  color: white;
}

.selected .day-indicator {
  background-color: white;
}

.day-indicator {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  position: absolute;
  bottom: 10rpx;
}

.feeling-indicator {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
}

.feeling-great {
  background-color: #4CAF50;
}

.feeling-good {
  background-color: #8BC34A;
}

.feeling-fair {
  background-color: #FFC107;
}

.feeling-poor {
  background-color: #F44336;
}

.record-section {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.record-date {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #4CAF50;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 15rpx;
  color: #666;
}

.feeling-section {
  margin-bottom: 25rpx;
}

.feeling-display {
  display: flex;
  align-items: center;
  flex-direction: row; 
}

.feeling-emoji {
  font-size: 32rpx;
  margin-right: 10rpx;
  display: inline-flex;
  align-items: center;
}

.feeling-text {
  font-size: 32rpx;
  display: inline-flex;
  align-items: center;
}

.metrics-section {
  margin-bottom: 25rpx;
}

.metrics-grid {
  display: flex;
  flex-wrap: wrap;
}

.metric-item {
  width: 33.33%;
  margin-bottom: 15rpx;
}

.metric-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 5rpx;
}

.metric-value {
  font-size: 30rpx;
  font-weight: bold;
}

.symptoms-section {
  margin-bottom: 25rpx;
}

.symptoms-list {
  display: flex;
  flex-wrap: wrap;
}

.symptom-tag {
  padding: 10rpx 20rpx;
  background-color: #F5F5F5;
  color: #666;
  border-radius: 30rpx;
  font-size: 26rpx;
  margin-right: 15rpx;
  margin-bottom: 15rpx;
}

.note-section {
  margin-bottom: 25rpx;
}

.note-content {
  background-color: #F9F9F9;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

.no-record {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: white;
  border-radius: 20rpx;
  padding: 60rpx 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.add-record-btn {
  background-color: #4CAF50;
  color: white;
  font-size: 28rpx;
  padding: 15rpx 40rpx;
  border-radius: 50rpx;
}

.record-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.delete-btn {
  font-size: 28rpx;
  color: #E53935;
  padding: 10rpx 20rpx;
  border: 1px solid #E53935;
  border-radius: 30rpx;
  min-width: 80rpx;
  text-align: center;
  line-height: 40rpx;
  /* 增加以下内容 */
  cursor: pointer;
}